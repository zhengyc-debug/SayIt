[Unit]
Description=SayIt voice tutor (uvicorn, 127.0.0.1:8787)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sayit
Group=sayit
WorkingDirectory=/opt/sayit

# 唯一需要的外部配置是 admin 密码。其它状态（账号/配置/记录/签名密钥）
# 全在 /opt/sayit/data/sayit.db 里，不需要任何 .env 文件。
Environment=PYTHONUNBUFFERED=1
Environment=SAYIT_DATA_DIR=/opt/sayit/data
Environment=SAYIT_LOG_DIR=/opt/sayit/log
Environment=SAYIT_ADMIN_PASSWORD=123456

# 只监听回环，TLS 交给 nginx
ExecStart=/opt/sayit/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8787 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1

Restart=always
RestartSec=3

# 日志进 journald：journalctl -u sayit -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sayit

# 轻量加固：整机只读，data/ 可写
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/opt/sayit/data

[Install]
WantedBy=multi-user.target
