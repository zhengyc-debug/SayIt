# ============================================================
# SayIt - 环境变量（.env 已被 .gitignore 忽略，不会进 Git）
# 这里的值只是"首次启动时的种子值"；之后在网页 /settings 里改的配置
# 会存进 data/settings.json，优先级高于本文件。
# ============================================================

# 默认语音供应商：doubao | qwen_omni | openai_realtime
VOICE_PROVIDER=doubao

# 豆包（火山引擎）API Key —— 控制台 > API Key 管理
DOUBAO_API_KEY=
DOUBAO_PROJECT=default

# 可选：其他供应商，用到再填
QWEN_API_KEY=
OPENAI_API_KEY=
