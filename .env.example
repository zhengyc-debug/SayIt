# ============================================================
# SayIt - 环境变量（.env 已被 .gitignore 忽略，不会进 Git）
#
# 这里只放「服务器自己的、与用户无关」的东西。
# 所有 API Key（豆包 / 千问 / OpenAI / DeepSeek）都不在这里 ——
# 每个账号登录后到「设置」页自己填，存在 data/users/<用户名>/settings.json，
# 互相看不到。
#
# 本文件可以不存在：没有它也能正常启动。
# ============================================================

# 日志级别：DEBUG | INFO | WARNING | ERROR（默认 INFO）
# 排查豆包 WebSocket 问题时改成 DEBUG；日志同时写入 log/sayit.log
LOG_LEVEL=INFO

# 登录 cookie 的签名密钥（可选）。
# 不填时首次启动自动生成并保存到 data/secret.key，重启不会掉登录。
# SECRET_KEY=
